---
import FullScreen from "./FullScreen.astro";
---
<div class="absolute right-0 m-6">

    <FullScreen></FullScreen>
</div>

<div class="
select-none
    h-screen flex items-center justify-center
    text-white ">

    <div id="timeClock" class="gap-10  flex md:flex-row flex-col md:text-[350px] text-9xl items-center">
        <div class="md:h-[450px] w-[450px] h-auto flex items-center justify-center bg-[#0F0F0F] px-10 rounded-2xl relative">
            <div id="date" class="md:text-2xl text-sm w-auto absolute top-3 transform translate-y-1/2"></div>
            <div class="bg-gray-950 absolute w-[-webkit-fill-available] h-1.5  z-10 "></div>
            <div id="hour" class=" ">
            </div>
            <div class=" md:text-4xl  text-sm  absolute md:bottom-10  bottom-3  md:left-10 left-3 ">AM</div>

        </div>

        <div class="md:h-[450px] w-[450px] h-auto flex items-center justify-center bg-[#0F0F0F] px-10  rounded-3xl  relative">
            <div id="day" class="md:text-2xl text-sm w-auto absolute top-3 transform translate-y-1/2"></div>

            <div class="bg-gray-950 absolute w-[-webkit-fill-available] h-1.5  z-10 "></div>

            <div id="min"></div>
            <div class=" md:text-4xl  text-sm  absolute md:bottom-10  bottom-3  md:right-10 right-3 " id="sec"></div>
        </div>
    </div>
</div>

<script>
    // let timeCurrent = document.getElementById("timeClock");
    let hourCurrent = document.getElementById("hour");
    let minCurrent = document.getElementById("min");
    let secCurrent = document.getElementById("sec");
    let dateElement = document.getElementById("date");
    let dayElement = document.getElementById("day");
    if (dateElement && dayElement) {
        let currentDate = new Date();
        dateElement.textContent = `${currentDate.getDate()}/${currentDate.getMonth() + 1}/${currentDate.getFullYear()}`;

        let daysOfWeek = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        dayElement.textContent = daysOfWeek[currentDate.getDay()];
    }


    function updateTime() {
        const time = new Date();
        const hours = time.getHours();
        const minutes = time.getMinutes();
        const seconds = time.getSeconds();

        const formattedHours = hours < 10 ? `0${hours}` : hours;
        const formattedMinutes = minutes < 10 ? `0${minutes}` : minutes;
        const formattedSeconds = seconds < 10 ? `0${seconds}` : seconds;

        if (hourCurrent && minCurrent && secCurrent) {
            hourCurrent.innerText = `${formattedHours}`;
            minCurrent.innerText = `${formattedMinutes}`;
            secCurrent.innerText = `${formattedSeconds}`;
        }
    }

    setInterval(updateTime, 1000);
    updateTime();
</script>

<style>
    #timeClock {
        font-family: "cunia", sans-serif;
        font-weight: 400;
        font-style: normal;
    }
</style>
