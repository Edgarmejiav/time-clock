---
import FullScreen from "./FullScreen.astro";
---
<div class="absolute right-0 m-6">

    <FullScreen></FullScreen>
</div>

<div class="
select-none
    h-screen flex items-center justify-center
    text-white ">

    <div id="timeClock"
         class=" min-[2000px]:scale-[2.5] scale-[1.4] gap-10  flex md:flex-row flex-col md:text-[350px] text-9xl items-center">
        <div class="md:h-[500px] md:w-[500px] w-auto h-[250px] flex items-center justify-center bg-[#0F0F0F] px-10 rounded-2xl relative">
            <div id="date" class="md:text-2xl text-sm w-auto absolute top-3 transform translate-y-1/2"></div>
            <div class="bg-[#0F0F0F] absolute w-[-webkit-fill-available] h-1.5  z-10 "></div>
            <div id="hour" class=" ">
            </div>
            <div id="dayampm" class=" md:text-4xl  text-sm  absolute md:bottom-10  bottom-3  md:left-10 left-3 ">
            </div>

        </div>

        <div class="md:h-[500px] md:w-[500px] w-auto  h-[250px] flex items-center justify-center bg-[#0F0F0F] px-10  rounded-3xl  relative">
            <div id="day" class="md:text-2xl text-sm w-auto absolute top-3 transform translate-y-1/2"></div>

            <div class="bg-[#0F0F0F] absolute w-[-webkit-fill-available] h-1.5  z-10 "></div>

            <div id="min"></div>
            <div class=" md:text-4xl  text-sm  absolute md:bottom-10  bottom-3  md:right-10 right-3 " id="sec"></div>
        </div>
    </div>
</div>

<script>
    const hourCurrent = document.getElementById("hour");
    const minCurrent = document.getElementById("min");
    const secCurrent = document.getElementById("sec");
    const dateElement = document.getElementById("date");
    const dayElement = document.getElementById("day");
    const dayAmPm = document.getElementById("dayampm");

    const daysOfWeek = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

    function updateTextContent(element: any, newValue: any) {
        if (element && element.textContent !== newValue) {
            element.textContent = newValue;
        }
    }

    function updateTime() {
        const time = new Date();

        const hours = time.getHours();
        const minutes = time.getMinutes();
        const seconds = time.getSeconds();

        updateTextContent(hourCurrent, hours < 10 ? `0${hours}` : `${hours}`);
        updateTextContent(minCurrent, minutes < 10 ? `0${minutes}` : `${minutes}`);
        updateTextContent(secCurrent, seconds < 10 ? `0${seconds}` : `${seconds}`);
        updateTextContent(dayAmPm, hours >= 12 ? 'PM' : 'AM');

        const currentDate = `${time.getDate()}/${time.getMonth() + 1}/${time.getFullYear()}`;
        updateTextContent(dateElement, currentDate);

        const currentDay = daysOfWeek[time.getDay()];
        updateTextContent(dayElement, currentDay);
    }

    updateTime();
    setInterval(updateTime, 1000);
</script>


<style>
    #timeClock {
        font-family: "sf", sans-serif;
        font-weight: 400;
        font-style: normal;
    }
</style>
