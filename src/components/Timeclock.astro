---
---
<div class="
select-none
    h-screen flex items-center justify-center
    text-white ">
    <div id="timeClock" class="gap-10  flex md:flex-row flex-col md:text-[350px] text-9xl items-center">
        <span class="md:h-[500px] h-auto flex items-center justify-center bg-[#0F0F0F] px-10 rounded-2xl relative">
                <span class="md:text-2xl text-sm absolute top-3 md:top-10 left-3 md:left-10 ">AM</span>
                <span id="hour" class=" md:"></span>
        </span>

        <span class="md:h-[500px] h-auto flex items-center justify-center bg-[#0F0F0F] px-10  rounded-3xl  relative">
        <span id="min"></span>
        <span class=" md:text-6xl  text-sm  absolute md:bottom-10  bottom-3  md:right-10 right-3 " id="sec"></span>
        </span>
    </div>
</div>

<script>
    // let timeCurrent = document.getElementById("timeClock");
    let hourCurrent = document.getElementById("hour");
    let minCurrent = document.getElementById("min");
    let secCurrent = document.getElementById("sec");

    function updateTime() {
        const time = new Date();
        const hours = time.getHours();
        const minutes = time.getMinutes();
        const seconds = time.getSeconds();

        const formattedHours = hours < 10 ? `0${hours}` : hours;
        const formattedMinutes = minutes < 10 ? `0${minutes}` : minutes;
        const formattedSeconds = seconds < 10 ? `0${seconds}` : seconds;

        if (hourCurrent && minCurrent && secCurrent) {
            hourCurrent.innerText = `${formattedHours}`;
            minCurrent.innerText = `${formattedMinutes}`;
            secCurrent.innerText = `${formattedSeconds}`;
        }
    }

    setInterval(updateTime, 1000);
    updateTime();
</script>

<style>
    #timeClock {
        font-family: "cunia", sans-serif;
        font-weight: 400;
        font-style: normal;
    }
</style>
